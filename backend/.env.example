# 复制为 .env 后使用。密钥禁止提交、禁止入库。
APP_ROLE=all
HTTP_ADDR=:8080
HTTP_TIMEOUT=15s
HTTP_BODY_LIMIT=1048576
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgres://cga:cga@127.0.0.1:5432/cga?sslmode=disable

# 至少 32 字符；仅环境变量
JWT_SECRET=dev-only-change-me-32-chars-min!!
JWT_TTL=15m

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cga-api

# 默认关闭。true 时必须提供 16 字节 SM4 密钥（32 hex）
SM_CRYPTO_ENABLED=false
SM4_KEY_HEX=

BOOTSTRAP_USERNAME=demo
BOOTSTRAP_PASSWORD=demo-pass-change-me

SHUTDOWN_TIMEOUT=10s
OUTBOX_INTERVAL=2s
